# =====================================================================
# Buildzy — Supabase Environment Configuration
# =====================================================================
# To connect Buildzy to your live Supabase project:
# 1. Copy this file to `.env` (or `.env.local`)
# 2. Fill in your project URL and public Anon Key from Supabase Dashboard:
#    Project Settings -> API -> Project URL & Project API Keys (anon / public)
# 3. Apply the database migrations located in:
#    `supabase/migrations/20261011_initial_schema.sql`
#
# NOTE: If these variables are not configured or left empty, Buildzy
# will automatically operate in offline 'Demo Showcase Mode' for college
# presentations and testing, without throwing errors or breaking the UI.
# =====================================================================

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# (Optional legacy alias: VITE_SUPABASE_ANON_KEY)
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_key

# Server-side Gemini AI Configuration (Backend only — never exposed to client)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
PORT=3001